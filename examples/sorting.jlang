# Insertion sort and merge sort (also compiles natively)

fn insertion_sort(xs) {
  for i in 1..<len(xs) {
    key = xs[i]
    j = i - 1
    while j >= 0 and xs[j] > key {
      xs[j + 1] = xs[j]
      j -= 1
    }
    xs[j + 1] = key
  }
  xs
}

fn merge(a, b) {
  out = []
  i = 0
  j = 0
  while i < len(a) and j < len(b) {
    if a[i] <= b[j] {
      push(out, a[i])
      i += 1
    } else {
      push(out, b[j])
      j += 1
    }
  }
  while i < len(a) {
    push(out, a[i])
    i += 1
  }
  while j < len(b) {
    push(out, b[j])
    j += 1
  }
  out
}

fn merge_sort(xs) {
  if len(xs) <= 1 { return xs }
  mid = len(xs) // 2
  left = []
  right = []
  for i in 0..<len(xs) {
    if i < mid { push(left, xs[i]) } else { push(right, xs[i]) }
  }
  merge(merge_sort(left), merge_sort(right))
}

# Make a list of pseudo-random numbers (the same every run)
seed = 42
data = []
for _ in 1..20 {
  seed = (seed * 1103515245 + 12345) % 2147483648
  push(data, seed % 100)
}
print("data:     ", data)
print("insertion:", insertion_sort([x for x in data]))
print("merge:    ", merge_sort(data))
print("floats:   ", merge_sort([3.5, -1.25, 2.0, 0.5]))
print("words:    ", merge_sort(["pear", "apple", "fig", "banana"]))
