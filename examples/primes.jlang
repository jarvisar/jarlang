# Sieve of Eratosthenes
# Run natively with: jarlang run --native examples/primes.jlang

fn sieve(n) {
  is_prime = [true] * (n + 1)
  is_prime[0] = false
  is_prime[1] = false
  i = 2
  while i * i <= n {
    if is_prime[i] {
      for multiple in range(i * i, n + 1, i) {
        is_prime[multiple] = false
      }
    }
    i += 1
  }
  [k for k in 0..n if is_prime[k]]
}

ps = sieve(100)
print("primes below 100:", ps)
print("there are", len(ps), "of them, summing to", sum(ps))

# Count twin primes (p and p + 2 are both prime)
big = sieve(2000)
twins = 0
for p in big {
  if p + 2 in big {
    twins += 1
  }
}
print("twin prime pairs below 2000:", twins)

# Goldbach's conjecture: every even number > 2 is the sum of two primes
fn goldbach(n) {
  for p in big {
    if p > n // 2 { break }
    if is_prime(n - p) { return p }
  }
  -1
}
for n in range(4, 31, 2) {
  p = goldbach(n)
  write("{n} = {p} + {n - p}   ")
}
print()
