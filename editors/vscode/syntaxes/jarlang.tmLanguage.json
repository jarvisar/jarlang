{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JarLang",
  "scopeName": "source.jarlang",
  "fileTypes": [
    "jlang"
  ],
  "comment": "Generated by editors/vscode/scripts/gen-grammar.py - edit that script, not this file.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#import"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#lambda"
    },
    {
      "include": "#math-function"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#return-type"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#dict-keys"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.jarlang",
          "match": "(#).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.jarlang"
            }
          }
        }
      ]
    },
    "import": {
      "begin": "\\b(import)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.import.jarlang"
        }
      },
      "end": "(?=[;#])|$",
      "patterns": [
        {
          "include": "#strings"
        },
        {
          "match": "\\b(as)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.import.jarlang"
            },
            "2": {
              "name": "entity.name.namespace.jarlang"
            }
          }
        },
        {
          "match": "\\bas\\b",
          "name": "keyword.control.import.jarlang"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "include": "#string-double"
        },
        {
          "include": "#string-single"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.jarlang",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.jarlang"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.jarlang"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.jarlang",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.jarlang"
        }
      },
      "end": "'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.jarlang"
        }
      },
      "patterns": [
        {
          "include": "#escapes"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.jarlang",
          "match": "\\\\(?:[ntr0\\\\\\\"'{}eab]|u\\{[0-9A-Fa-f]{1,6}\\}|u[0-9A-Fa-f]{4}|$)"
        },
        {
          "name": "invalid.illegal.unknown-escape.jarlang",
          "match": "\\\\."
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.jarlang",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.jarlang"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.jarlang"
        }
      },
      "contentName": "meta.embedded.line.jarlang source.jarlang",
      "patterns": [
        {
          "match": "(:)([^{}\\\"'\\])]*)(?=\\})",
          "captures": {
            "1": {
              "name": "punctuation.separator.format-spec.jarlang"
            },
            "2": {
              "name": "constant.other.format-spec.jarlang"
            }
          }
        },
        {
          "include": "#groups"
        },
        {
          "include": "$self"
        }
      ]
    },
    "groups": {
      "patterns": [
        {
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.parenthesis.begin.jarlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.parenthesis.end.jarlang"
            }
          },
          "patterns": [
            {
              "include": "#groups"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.list.begin.jarlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.list.end.jarlang"
            }
          },
          "patterns": [
            {
              "include": "#groups"
            },
            {
              "include": "$self"
            }
          ]
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.dict.begin.jarlang"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.dict.end.jarlang"
            }
          },
          "patterns": [
            {
              "include": "#groups"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "function-declaration": {
      "name": "meta.function.jarlang",
      "begin": "\\b(fn)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.jarlang"
        },
        "2": {
          "name": "entity.name.function.jarlang"
        },
        "3": {
          "name": "punctuation.definition.parameters.begin.jarlang"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.jarlang"
        }
      },
      "patterns": [
        {
          "include": "#parameters"
        }
      ]
    },
    "lambda": {
      "name": "meta.function.lambda.jarlang",
      "begin": "\\b(fn)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.type.function.jarlang"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.jarlang"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.jarlang"
        }
      },
      "patterns": [
        {
          "include": "#parameters"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "match": "(?:(?<=\\()|(?<=,))\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "variable.parameter.jarlang"
            }
          }
        },
        {
          "match": "(:)\\s*((?:fn|nil|[\\p{L}_][\\p{L}\\p{N}_]*)(?:\\[[^\\]]*\\])?)",
          "captures": {
            "1": {
              "name": "punctuation.separator.annotation.jarlang"
            },
            "2": {
              "patterns": [
                {
                  "include": "#type-names"
                }
              ]
            }
          }
        },
        {
          "match": ",",
          "name": "punctuation.separator.parameters.jarlang"
        },
        {
          "match": "=(?![=>])",
          "name": "keyword.operator.assignment.jarlang"
        },
        {
          "include": "#groups"
        },
        {
          "include": "$self"
        }
      ]
    },
    "math-function": {
      "comment": "Math-style definition at the start of a line: f(x, y) = ...",
      "match": "^\\s*([\\p{L}_][\\p{L}\\p{N}_]*)(\\()([^()]*)(\\))\\s*(=)(?![=>])",
      "captures": {
        "1": {
          "name": "entity.name.function.jarlang"
        },
        "2": {
          "name": "punctuation.definition.parameters.begin.jarlang"
        },
        "3": {
          "patterns": [
            {
              "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
              "name": "variable.parameter.jarlang"
            },
            {
              "match": ",",
              "name": "punctuation.separator.parameters.jarlang"
            }
          ]
        },
        "4": {
          "name": "punctuation.definition.parameters.end.jarlang"
        },
        "5": {
          "name": "keyword.operator.assignment.jarlang"
        }
      }
    },
    "return-type": {
      "match": "(->)\\s*((?:fn|nil|[\\p{L}_][\\p{L}\\p{N}_]*)(?:\\[[^\\]]*\\])?)",
      "captures": {
        "1": {
          "name": "keyword.operator.arrow.jarlang"
        },
        "2": {
          "patterns": [
            {
              "include": "#type-names"
            }
          ]
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(const)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s*(:)\\s*((?:fn|nil|[\\p{L}_][\\p{L}\\p{N}_]*)(?:\\[[^\\]]*\\])?))?",
          "captures": {
            "1": {
              "name": "storage.type.const.jarlang"
            },
            "2": {
              "name": "variable.other.constant.jarlang"
            },
            "3": {
              "name": "punctuation.separator.annotation.jarlang"
            },
            "4": {
              "patterns": [
                {
                  "include": "#type-names"
                }
              ]
            }
          }
        },
        {
          "match": "\\b(let)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)(?:\\s*(:)\\s*((?:fn|nil|[\\p{L}_][\\p{L}\\p{N}_]*)(?:\\[[^\\]]*\\])?))?",
          "captures": {
            "1": {
              "name": "storage.type.let.jarlang"
            },
            "2": {
              "name": "variable.other.declaration.jarlang"
            },
            "3": {
              "name": "punctuation.separator.annotation.jarlang"
            },
            "4": {
              "patterns": [
                {
                  "include": "#type-names"
                }
              ]
            }
          }
        },
        {
          "match": "\\b(catch)\\b(?:\\s+([\\p{L}_][\\p{L}\\p{N}_]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.exception.jarlang"
            },
            "2": {
              "name": "variable.other.exception.jarlang"
            }
          }
        }
      ]
    },
    "type-names": {
      "patterns": [
        {
          "match": "\\b(?:float|bool|dict|list|any|int|nil|num|str|fn)\\b",
          "name": "support.type.primitive.jarlang"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*",
          "name": "entity.name.type.jarlang"
        },
        {
          "match": "[\\[\\],]",
          "name": "punctuation.definition.type.jarlang"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(?:continue|import|return|break|catch|throw|while|elif|else|for|try|if|in)\\b",
          "name": "keyword.control.jarlang"
        },
        {
          "match": "\\bfn\\b",
          "name": "storage.type.function.jarlang"
        },
        {
          "match": "\\b(?:let|const)\\b",
          "name": "storage.type.jarlang"
        },
        {
          "match": "\\b(?:and|not|or)\\b",
          "name": "keyword.operator.logical.jarlang"
        },
        {
          "match": "\\b(?:true|false)\\b",
          "name": "constant.language.boolean.jarlang"
        },
        {
          "match": "\\bnil\\b",
          "name": "constant.language.nil.jarlang"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:inf|nan|phi|tau|pi|e)(?![\\p{L}\\p{N}_])",
          "name": "support.constant.math.jarlang"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])(?:π|τ|φ)(?![\\p{L}\\p{N}_])",
          "name": "support.constant.math.jarlang"
        },
        {
          "match": "∞",
          "name": "support.constant.math.jarlang"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "match": "(?<![\\p{L}\\p{N}_])0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*",
          "name": "constant.numeric.hex.jarlang"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])0[bB][01](?:_?[01])*",
          "name": "constant.numeric.binary.jarlang"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])0[oO][0-7](?:_?[0-7])*",
          "name": "constant.numeric.octal.jarlang"
        },
        {
          "match": "(?<![\\p{L}\\p{N}_])\\d(?:_?\\d)*(?:\\.\\d(?:_?\\d)*)?(?:[eE][+-]?\\d(?:_?\\d)*)?",
          "name": "constant.numeric.decimal.jarlang"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "builtins used as methods: xs.map(f)",
          "match": "(\\.)\\s*(?:(starts_with|write_file|ends_with|enumerate|factorial|read_file|contains|divisors|index_of|is_alpha|is_digit|is_prime|linspace|variance|compose|factors|flatten|memoize|product|randint|replace|reverse|shuffle|assert|choice|choose|filter|insert|median|primes|random|reduce|remove|unique|values|atan2|chars|chunk|clamp|clock|count|error|first|float|floor|hypot|input|isqrt|items|lines|log10|lower|print|range|round|sleep|split|stdev|trunc|upper|write|acos|asin|atan|bool|cbrt|ceil|copy|cosh|dict|drop|each|exit|find|help|join|keys|last|list|log2|mean|mode|perm|plot|push|repr|seed|sign|sinh|sort|sqrt|take|tanh|trim|type|abs|all|any|bin|chr|cos|deg|doc|exp|fmt|gcd|get|has|hex|int|lcm|len|log|map|max|min|ord|pad|pop|pow|rad|sin|str|sum|tan|zip|ln))(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jarlang"
            },
            "2": {
              "name": "support.function.builtin.jarlang"
            }
          }
        },
        {
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\()",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jarlang"
            },
            "2": {
              "name": "entity.name.function.member.jarlang"
            }
          }
        },
        {
          "match": "(?<!\\.)(?<![\\p{L}\\p{N}_])(?:starts_with|write_file|ends_with|enumerate|factorial|read_file|contains|divisors|index_of|is_alpha|is_digit|is_prime|linspace|variance|compose|factors|flatten|memoize|product|randint|replace|reverse|shuffle|assert|choice|choose|filter|insert|median|primes|random|reduce|remove|unique|values|atan2|chars|chunk|clamp|clock|count|error|first|float|floor|hypot|input|isqrt|items|lines|log10|lower|print|range|round|sleep|split|stdev|trunc|upper|write|acos|asin|atan|bool|cbrt|ceil|copy|cosh|dict|drop|each|exit|find|help|join|keys|last|list|log2|mean|mode|perm|plot|push|repr|seed|sign|sinh|sort|sqrt|take|tanh|trim|type|abs|all|any|bin|chr|cos|deg|doc|exp|fmt|gcd|get|has|hex|int|lcm|len|log|map|max|min|ord|pad|pop|pow|rad|sin|str|sum|tan|zip|ln)(?![\\p{L}\\p{N}_])",
          "name": "support.function.builtin.jarlang"
        },
        {
          "match": "[\\p{L}_][\\p{L}\\p{N}_]*(?=\\()",
          "name": "entity.name.function.call.jarlang"
        },
        {
          "match": "(\\.)\\s*([\\p{L}_][\\p{L}\\p{N}_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.jarlang"
            },
            "2": {
              "name": "variable.other.property.jarlang"
            }
          }
        }
      ]
    },
    "dict-keys": {
      "patterns": [
        {
          "match": "([\\p{L}_][\\p{L}\\p{N}_]*)\\s*(:)(?=\\s)",
          "captures": {
            "1": {
              "name": "variable.other.property.key.jarlang"
            },
            "2": {
              "name": "punctuation.separator.key-value.jarlang"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "\\|>",
          "name": "keyword.operator.pipe.jarlang"
        },
        {
          "match": "\\.\\.<?",
          "name": "keyword.operator.range.jarlang"
        },
        {
          "match": "=>|->",
          "name": "keyword.operator.arrow.jarlang"
        },
        {
          "match": "//=|\\*\\*=|\\+=|-=|\\*=|/=|%=|\\^=",
          "name": "keyword.operator.assignment.compound.jarlang"
        },
        {
          "match": "==|!=|<=|>=|<|>|≤|≥|≠",
          "name": "keyword.operator.comparison.jarlang"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.jarlang"
        },
        {
          "match": "&&|\\|\\|",
          "name": "keyword.operator.logical.jarlang"
        },
        {
          "match": "(?<=[\\p{L}\\p{N}_)\\]])!",
          "name": "keyword.operator.factorial.jarlang"
        },
        {
          "match": "!",
          "name": "keyword.operator.logical.jarlang"
        },
        {
          "match": "√",
          "name": "keyword.operator.sqrt.jarlang"
        },
        {
          "match": "\\*\\*|//|[-+*/%^×÷·−]",
          "name": "keyword.operator.arithmetic.jarlang"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "\\\\$",
          "name": "punctuation.separator.continuation.line.jarlang"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.jarlang"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.statement.jarlang"
        },
        {
          "match": ":",
          "name": "punctuation.separator.colon.jarlang"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.jarlang"
        },
        {
          "match": "\\{",
          "name": "punctuation.section.block.begin.jarlang"
        },
        {
          "match": "\\}",
          "name": "punctuation.section.block.end.jarlang"
        },
        {
          "match": "[()]",
          "name": "punctuation.parenthesis.jarlang"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.definition.list.jarlang"
        }
      ]
    }
  }
}
