{
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:name}(${2:params}) {", "\t$0", "}"],
    "description": "Function declaration with a block body"
  },
  "Arrow function": {
    "prefix": "fna",
    "body": ["fn ${1:name}(${2:x}) => ${0:x}"],
    "description": "Function declaration with an expression body"
  },
  "Math function": {
    "prefix": "mf",
    "body": ["${1:f}(${2:x}) = ${0:x^2}"],
    "description": "Math-style function definition: f(x) = ..."
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition} {", "\t$0", "}"],
    "description": "If statement"
  },
  "If / else": {
    "prefix": "ife",
    "body": ["if ${1:condition} {", "\t$2", "} else {", "\t$0", "}"],
    "description": "If / else statement"
  },
  "For": {
    "prefix": "for",
    "body": ["for ${1:x} in ${2:xs} {", "\t$0", "}"],
    "description": "Loop over a list, string, dict or range"
  },
  "For range": {
    "prefix": "fori",
    "body": ["for ${1:i} in ${2:1}..${3:10} {", "\t$0", "}"],
    "description": "Loop over an inclusive range of integers"
  },
  "While": {
    "prefix": "while",
    "body": ["while ${1:condition} {", "\t$0", "}"],
    "description": "While loop"
  },
  "Try / catch": {
    "prefix": "try",
    "body": ["try {", "\t$1", "} catch ${2:err} {", "\t$0", "}"],
    "description": "Handle errors"
  },
  "Print": {
    "prefix": "print",
    "body": ["print(${0})"],
    "description": "Print values"
  },
  "Print with interpolation": {
    "prefix": "pf",
    "body": ["print(\"${1:x} = {${2:$1}}\")$0"],
    "description": "Print an interpolated string"
  },
  "List comprehension": {
    "prefix": "comp",
    "body": ["[${1:x^2} for ${2:x} in ${3:1..10}${4: if ${5:condition}}]$0"],
    "description": "List comprehension"
  }
}
